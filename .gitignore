# ===== JoeSkills .gitignore =====
# 防止个人/项目私有数据与构建产物被上传到 GitHub
# Prevent private project data and build artifacts from being pushed to GitHub

# ---- 个人/项目私有数据（绝不提交） ----
# Personal / project-private data — never commit
.workbuddy/
.workbuddy/**

# ---- Python 缓存与字节码 ----
# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- 虚拟环境 / 依赖隔离 ----
# Virtual environments
.venv/
venv/
env/
ENV/
.venv/**

# ---- 构建 / 打包产物 ----
# Build & packaging output
build/
dist/
*.egg-info/
.eggs/

# ---- 日志与临时文件 ----
# Logs & temp files
*.log
*.tmp
*.bak
*.swp
.cache/

# ---- 操作系统文件 ----
# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---- 编辑器 / IDE ----
# Editor / IDE
.vscode/
.idea/
*.iml
